{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Generates abandoned cities across the world - Fabric Port by sunshainy",
  "authors": [
    "sunshainy",
    "McJty (original Forge mod)"
  ],
  "contact": {
    "sources": "https://github.com/Sunshainy/Lost-Cities-port-Fabric"
  },
  "license": "MIT",
  "icon": "assets/lostcity/icon.png",

  "environment": "*",

  "entrypoints": {
    "main": [
      "com.lostcity.LostCityMod"
    ],
    "client": [
      "com.lostcity.LostCityModClient"
    ]
  },

  "mixins": [
    "lostcity.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${minecraft}",
    "java": "${java}",
    "fabric-api": "*"
  },

  "suggests": {
    "cloth-config": ">=11.0.0"
  }
}

{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Generates abandoned cities across the world - Fabric Port by sunshainy",
  "authors": [
    "sunshainy",
    "McJty (original Forge mod)"
  ],
  "contact": {
    "sources": "https://github.com/Sunshainy/Lost-Cities-port-Fabric"
  },
  "license": "MIT",
  "icon": "assets/lostcities/icon.png",

  "environment": "*",

  "accessWidener": "META-INF/lostcities.accesswidener",

  "entrypoints": {
    "main": [
      "mcjty.lostcities.LostCities"
    ],
    "client": [
      "mcjty.lostcities.setup.ClientSetup"
    ]
  },

  "mixins": [
    "lostcities.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${minecraft}",
    "java": "${java}",
    "fabric-api": "*",
    "forgeconfigapiport": "*"
  }
}
